# Скопируйте этот файл в .env и заполните BOT_TOKEN локально.
BOT_TOKEN=
ADMIN_IDS=your_telegram_id
OWNER_CHAT_ID=your_telegram_id
CURRENCY=RUB
DB_FILENAME=shop.db

# Не требуется для первой версии без оплаты.
PAYMENT_PROVIDER_TOKEN=

# Заполните HTTPS-адрес Mini App, когда будете публиковать webapp.
WEBAPP_URL=
